# ==============================================================================
# Vaultwarden Environment Configuration
# ==============================================================================

# --- MCP Server Settings ---
HOST=127.0.0.1
PORT=8000
TRANSPORT=stdio # options: stdio, streamable-http, sse
AUTH_TYPE=none # network listeners outside loopback require configured authentication

# --- Runtime Features ---
MCP_TOOL_MODE=intent
ENABLE_OTEL=False
# Configure telemetry endpoint, credential, and TLS references in AgentConfig.

# --- Enterprise Security & Access Governance (Eunomia) ---
EUNOMIA_TYPE=none # options: none, embedded, remote
EUNOMIA_POLICY_FILE=mcp_policies.json

# --- Provider Runtime (reference-only; no values belong here) ---
# Configure AgentConfig.provider_configs.vaultwarden as a JSON object (env var or
# config.json) with this shape:
#   {
#     "vaultwarden": {
#       "enabled": true,
#       "endpoint_ref": "env://VAULTWARDEN_URL",          # HTTPS or loopback only
#       "tls_profile_ref": "env://VAULTWARDEN_TLS_PROFILE", # XOR tls_profile (inline JSON)
#       "credential_refs": {
#         "CLIENT_ID": "env://VAULTWARDEN_CLIENT_ID",           # personal API key
#         "CLIENT_SECRET": "secret://vaultwarden/client-secret", # personal API key
#         "MASTER_PASSWORD": "secret://vaultwarden/master-password", # decrypted vault ops only
#         "ADMIN_TOKEN": "secret://vaultwarden/admin-token"      # vaultwarden_admin only
#       },
#       "selector_refs": { "CRYPTO_BACKEND": "env://VAULTWARDEN_CRYPTO_BACKEND" }
#     }
#   }
# `credential_refs` aliases are fixed, UPPER-CASE keys (AgentConfig requirement).
# `CRYPTO_BACKEND` resolves to "native" (default, pure Python) or "bw_cli" (requires
# the Bitwarden CLI installed). References are env://, vault://, or secret:// only —
# resolved values are never written to this file or to configuration in the repo.

# --- Tool Toggle Switches (one per MCP tool tag; set False to disable) ---
SYSTEMTOOL=True
ACCOUNTSTOOL=True
CIPHERSTOOL=True
FOLDERSTOOL=True
ORGANIZATIONSTOOL=True
SENDSTOOL=True
ADMINTOOL=True
MAINTENANCETOOL=True

# --- Container image references (docker/mcp.compose.yml, docker/agent.compose.yml) ---
# Both are required, immutable digest references — no default is provided.
VAULTWARDEN_MCP_IMAGE=  # e.g. registry.example.invalid/vaultwarden-mcp@sha256:<digest>
VAULTWARDEN_AGENT_IMAGE=  # e.g. registry.example.invalid/vaultwarden-mcp@sha256:<digest>

# --- Compose runtime mounts ---
# Host directory bind-mounted read-only to /etc/agent-utilities in both compose files;
# must contain the AgentConfig that resolves provider_configs.vaultwarden above.

# --- Container compose inputs (docker/*.compose.yml) ---
# Unset image variables fall back to an all-zero sha256 digest: a non-deployable
# sentinel that fails at pull time. Set them to a reviewed image@sha256 digest.
# AUTH_TYPE defaults to jwt (never unauthenticated); AGENT_CONFIG_DIR defaults to
# /etc/agent-utilities and must exist on the host.
